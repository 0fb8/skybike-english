{
  "name": "skybike-english",
  "version": "0.1.0",
  "description": "空とぶ自転車で世界一周しながら英単語を書き取るブラウザゲーム",
  "scripts": {
    "content:check": "tsx scripts/check-content.ts",
    "tts": "tsx scripts/tts/generate.ts",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run content:check && npm run typecheck && npm run test",
    "content:levels": "tsx scripts/levels/report.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-polly": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
